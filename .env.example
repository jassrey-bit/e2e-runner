# Carpeta de BaseProject (por defecto ../BaseProject)
# BASEPROJECT_DIR=C:\Users\GSF\Documents\Proyectos\BaseProject

# Plataformas que se pueden elegir en la web (si no se define, usa PLATAFORMA del .env de BaseProject)
# E2E_PLATFORMS=financiados,automatedtests

# E2E_DEFAULT_VERSION=v2
# E2E_MAX_PARALLEL_RUNS=2
# E2E_RUN_TIMEOUT_MIN=120
# E2E_RETENTION_DAYS=5

# Valores que se ocultan en logs y en el texto de los pasos (separados por coma)
# E2E_MASK_VALUES=

# Dominio con el que se verifica que una plataforma nueva responda (BaseProject usa https://{plataforma}.cloudgsf.com)
# E2E_PLATFORM_DOMAIN=cloudgsf.com
