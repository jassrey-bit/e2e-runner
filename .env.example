# Repositorio de BaseProject. Si se define, cada corrida baja la rama elegida en la web
# (como el checkout de GitHub Actions). Si no, se usa la carpeta BASEPROJECT_DIR tal como está.
# E2E_REPO_URL=https://github.com/4-Bytes/qa-automatizacion-cucumber.git
# Token de solo lectura (repos privados en el servidor). En local, git usa tus credenciales.
# E2E_REPO_TOKEN=
# Rama preseleccionada en la web (vacío = la rama principal del repositorio)
# E2E_DEFAULT_BRANCH=feature/QA-test-avanzados-V2
# Cuántas versiones (commits) preparadas se guardan en disco
# E2E_MAX_CHECKOUTS=6

# Carpeta de BaseProject para el modo local (por defecto ../BaseProject)
# BASEPROJECT_DIR=C:\Users\GSF\Documents\Proyectos\BaseProject

# Plataformas que se pueden elegir en la web (si no se define, usa PLATAFORMA del .env de BaseProject)
# E2E_PLATFORMS=financiados,automatedtests

# E2E_DEFAULT_VERSION=v2
# E2E_MAX_PARALLEL_RUNS=2
# E2E_RUN_TIMEOUT_MIN=120
# E2E_RETENTION_DAYS=5

# Valores que se ocultan en logs y en el texto de los pasos (separados por coma)
# E2E_MASK_VALUES=

# Dominio con el que se verifica que una plataforma nueva responda (BaseProject usa https://{plataforma}.cloudgsf.com)
# E2E_PLATFORM_DOMAIN=cloudgsf.com
